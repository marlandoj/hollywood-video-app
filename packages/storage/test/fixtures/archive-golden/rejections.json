{
  "schema": "hv-archive-rejection-matrix/1",
  "description": "Shared rejection matrix for the archive manifest contracts. Each row mutates one committed golden manifest (archive.json, source/snapshot.json or the golden clips/manifest.json) with a single JSON-pointer operation and names the JSON pointer both validators must report. `set` assigns `value` at `pointer` (a value of the form {\"$repeat\": [text, count]} expands to text repeated count times), `delete` removes the member at `pointer`, and `replicate` replaces the array at `pointer` with `count` copies of its first item whose `path` gains a distinct suffix. `entry`, when present, is the message the real archive entry point reports instead, because a container limit rejects the row before the manifest is parsed.",
  "rows": [
    {"name": "archive schema version 2", "document": "hv-project-archive/1", "op": "set", "pointer": "/schema", "value": "hv-project-archive/2", "expect": "/schema"},
    {"name": "archive missing totalBytes", "document": "hv-project-archive/1", "op": "delete", "pointer": "/totalBytes", "expect": "/totalBytes"},
    {"name": "archive extra top-level key", "document": "hv-project-archive/1", "op": "set", "pointer": "/createdAt", "value": "2026-09-14T00:00:00Z", "expect": "/createdAt"},
    {"name": "archive files is an object", "document": "hv-project-archive/1", "op": "set", "pointer": "/files", "value": {}, "expect": "/files"},
    {"name": "archive file entry extra key", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/contentType", "value": "video/mp4", "expect": "/files/0/contentType"},
    {"name": "archive bytes negative", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/bytes", "value": -1, "expect": "/files/0/bytes"},
    {"name": "archive bytes above 8 GiB", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/bytes", "value": 8589934593, "expect": "/files/0/bytes"},
    {"name": "archive bytes as string", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/bytes", "value": "12", "expect": "/files/0/bytes"},
    {"name": "archive bytes as boolean", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/bytes", "value": true, "expect": "/files/0/bytes"},
    {"name": "archive sha256 uppercase", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/sha256", "value": {"$repeat": ["A", 64]}, "expect": "/files/0/sha256"},
    {"name": "archive sha256 63 characters", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/sha256", "value": {"$repeat": ["a", 63]}, "expect": "/files/0/sha256"},
    {"name": "archive path with backslash", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/path", "value": "artifacts\\escaped", "expect": "/files/0/path"},
    {"name": "archive path with space", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/path", "value": "artifacts/two words", "expect": "/files/0/path"},
    {"name": "archive path with leading slash", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/path", "value": "/artifacts/absolute", "expect": "/files/0/path"},
    {"name": "archive path with trailing newline", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/path", "value": "artifacts/trailing\n", "expect": "/files/0/path"},
    {"name": "archive path 1025 characters", "document": "hv-project-archive/1", "op": "set", "pointer": "/files/0/path", "value": {"$repeat": ["a", 1025]}, "expect": "/files/0/path"},
    {"name": "archive totalBytes above 64 GiB", "document": "hv-project-archive/1", "op": "set", "pointer": "/totalBytes", "value": 68719476737, "expect": "/totalBytes"},
    {"name": "archive 100001 file entries", "document": "hv-project-archive/1", "op": "replicate", "pointer": "/files", "count": 100001, "expect": "/files", "entry": "archive manifest is missing or too large"},
    {"name": "snapshot schema version 18", "document": "hv-state/1", "op": "set", "pointer": "/schema", "value": "hv-state/18", "expect": "/schema"},
    {"name": "snapshot missing files", "document": "hv-state/1", "op": "delete", "pointer": "/files", "expect": "/files"},
    {"name": "snapshot fifth state path", "document": "hv-state/1", "op": "set", "pointer": "/files/state~1secrets.json", "value": {"$repeat": ["a", 64]}, "expect": "/files/state~1secrets.json"},
    {"name": "snapshot missing state path", "document": "hv-state/1", "op": "delete", "pointer": "/files/queue~1jobs.json", "expect": "/files/queue~1jobs.json"},
    {"name": "snapshot non-hex digest", "document": "hv-state/1", "op": "set", "pointer": "/files/queue~1jobs.json", "value": {"$repeat": ["g", 64]}, "expect": "/files/queue~1jobs.json"},
    {"name": "snapshot summary extra field", "document": "hv-state/1", "op": "set", "pointer": "/summary/host", "value": "studio", "expect": "/summary/host"},
    {"name": "snapshot summary negative field", "document": "hv-state/1", "op": "set", "pointer": "/summary/jobs", "value": -1, "expect": "/summary/jobs"},
    {"name": "clips schema version 2", "document": "hv-clips/1", "op": "set", "pointer": "/schema", "value": "hv-clips/2", "expect": "/schema"},
    {"name": "clips third top-level key", "document": "hv-clips/1", "op": "set", "pointer": "/worker", "value": "golden", "expect": "/worker"},
    {"name": "clip missing path", "document": "hv-clips/1", "op": "delete", "pointer": "/clips/0/path", "expect": "/clips/0/path"},
    {"name": "clip missing cost", "document": "hv-clips/1", "op": "delete", "pointer": "/clips/0/cost", "expect": "/clips/0/cost"},
    {"name": "clip seed negative", "document": "hv-clips/1", "op": "set", "pointer": "/clips/0/seed", "value": -1, "expect": "/clips/0/seed"},
    {"name": "clip seed fractional", "document": "hv-clips/1", "op": "set", "pointer": "/clips/0/seed", "value": 1.5, "expect": "/clips/0/seed"},
    {"name": "clip durationSec as string", "document": "hv-clips/1", "op": "set", "pointer": "/clips/0/durationSec", "value": "1", "expect": "/clips/0/durationSec"},
    {"name": "clip cost missing total_cost_usd", "document": "hv-clips/1", "op": "delete", "pointer": "/clips/0/cost/total_cost_usd", "expect": "/clips/0/cost/total_cost_usd"}
  ]
}
