{
  "name": "hollywood-video-app",
  "private": true,
  "puppeteer": { "skipDownload": true },
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@contentauth/c2pa-node": "0.9.9",
    "@fontsource/inter": "5.2.8",
    "@hyperframes/engine": "0.8.31",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "drizzle-orm": "0.45.2",
    "fontkit": "2.0.4",
    "hls.js": "1.6.13",
    "microsoft-cognitiveservices-speech-sdk": "1.51.0"
  },
  "scripts": {
    "start:api": "bun packages/api/src/server.ts",
    "start:worker": "bun packages/queue/src/worker.ts",
    "test": "bun test packages test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx oxlint packages scripts test",
    "build": "bun build packages/api/src/server.ts packages/queue/src/worker.ts --target=bun --outdir=dist",
    "smoke:runtime": "bun scripts/runtime-smoke.ts",
    "benchmark": "bun packages/benchmarks/src/run.ts",
    "benchmark:compare": "bun scripts/benchmark/compare.ts",
    "benchmark:paid": "bun packages/benchmarks/src/paid.ts",
    "benchmark:results": "bun packages/benchmarks/src/results.ts",
    "operator:grant": "bun scripts/operator-grant.ts",
    "sweep:expired": "bun scripts/sweep-expired.ts",
    "benchmark:animatic": "bun packages/benchmarks/src/animatic.ts",
    "storage:migrate": "bun scripts/migrate-storage.ts"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.2",
    "@types/fontkit": "2.0.9",
    "bun-types": "1.4.0",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "typescript": "5.9.3"
  }
}
