{
  "name": "hollywood-video-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hls.js": "1.6.13"
  },
  "scripts": {
    "start:api": "bun packages/api/src/server.ts",
    "start:worker": "bun packages/queue/src/worker.ts",
    "test": "bun test packages test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx oxlint packages scripts test",
    "build": "bun build packages/api/src/server.ts packages/queue/src/worker.ts --target=bun --outdir=dist",
    "smoke:runtime": "bun scripts/runtime-smoke.ts",
    "benchmark": "bun packages/benchmarks/src/run.ts",
    "benchmark:compare": "bun scripts/benchmark/compare.ts",
    "operator:grant": "bun scripts/operator-grant.ts",
    "sweep:expired": "bun scripts/sweep-expired.ts",
    "benchmark:animatic": "bun packages/benchmarks/src/animatic.ts",
    "storage:migrate": "bun scripts/migrate-storage.ts"
  },
  "devDependencies": {
    "bun-types": "1.4.0",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "typescript": "5.9.3"
  }
}
