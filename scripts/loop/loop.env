# Committed defaults for the execution loop. Override with .loop/loop.env (untracked).
LOOP_MAX_TURNS=200
LOOP_MAX_USD_PER_BUILD=25
LOOP_MAX_USD_PER_DAY=150
LOOP_PAID_ENVELOPE_USD=500
LOOP_PAID_ALERT_USD=450
LOOP_CRITIC_ROUNDS=3
LOOP_CI_RETRIES=3
LOOP_WALL_CLOCK_PER_INCREMENT=4h
LOOP_LINEAR_PROGRAM_ISSUE=ZOU-1584
# Private staging moved to the operator's desktop on 2026-09-19 (docs/STAGING-LOCAL.md, HV-032-04).
LOOP_STAGING_ROOT=/srv/rough-cut/staging
# The host's own supervisor (scripts/host_config.py); exported so the staging scripts see it.
export HV_SUPERVISOR_CONFIG=/etc/rough-cut/supervisord.conf
export HV_SUPERVISOR_RPC_URL=http://127.0.0.1:29011/RPC2
